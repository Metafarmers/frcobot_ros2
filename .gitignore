# Build-time / runtime SONAME symlinks created next to the versioned shared
# library. The concrete libfairino.so.X.Y.Z files are tracked; the symlinks
# (libfairino.so, libfairino.so.N) are regenerated by the build/install step.
fairino_hardware/libfairino/lib/libfairino.so
fairino_hardware/libfairino/lib/libfairino.so.[0-9]
